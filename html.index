<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXUS SECURE | نظام التحقق المركزي</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Changa:wght@300;500;700&display=swap');
        body { background: #050a09; color: white; font-family: 'Changa', sans-serif; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; margin: 0; }
        
        #top-bar { 
            position: fixed; top: 0; left: 0; right: 0; height: 70px; 
            background: #0a1612; border-bottom: 2px solid #2a9d8f; 
            display: none; justify-content: space-between; align-items: center; 
            padding: 0 30px; z-index: 5000;
        }

        .glass-box { background: rgba(19, 72, 58, 0.1); backdrop-filter: blur(25px); border: 1px solid rgba(42, 157, 143, 0.3); border-radius: 3rem; width: 100%; max-width: 450px; padding: 3rem; box-shadow: 0 0 50px rgba(0,0,0,0.8); }
        .input-style { background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(42, 157, 143, 0.2); transition: 0.3s; color: white; }
        .input-style:focus { border-color: #2a9d8f; background: rgba(42, 157, 143, 0.1); outline: none; }
        .btn-action { background: linear-gradient(135deg, #13483a 0%, #2a9d8f 100%); cursor: pointer; }
        .notification { position: fixed; top: 80px; right: 20px; padding: 15px 25px; border-radius: 15px; display: none; z-index: 6000; animation: slideIn 0.5s ease; }
        @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
        .hidden { display: none !important; }
        .pass-wrapper { position: relative; }
        .eye-icon { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #2a9d8f; opacity: 0.7; }
    </style>
</head>
<body>

    <div id="top-bar">
        <div class="flex items-center gap-3">
            <i data-lucide="shield-check" class="text-[#2a9d8f] w-6 h-6"></i>
            <span class="font-bold text-[#2a9d8f] text-lg tracking-widest">NEXUS SYSTEM</span>
        </div>
        <button onclick="logout()" class="bg-red-600/20 border border-red-500 text-red-500 px-6 py-2 rounded-xl text-sm font-bold hover:bg-red-500 hover:text-white transition flex items-center gap-2">
            <i data-lucide="power" class="w-4 h-4"></i> تسجيل الخروج
        </button>
    </div>

    <div id="notify" class="notification font-bold shadow-2xl"></div>

    <div id="auth-container">
        <div id="auth-card" class="glass-box text-center">
            <div id="auth-header">
                <i data-lucide="database" class="w-12 h-12 text-[#2a9d8f] mx-auto mb-4"></i>
                <h2 id="title" class="text-3xl font-bold mb-8">تسجيل <span class="text-[#2a9d8f]">الدخول</span></h2>
            </div>

            <form id="auth-form" class="space-y-5 text-right">
                <!-- خانة الاسم أصبحت مرئية في وضع إنشاء الحساب وتحتاج لملئها -->
                <div id="name-field" class="hidden">
                    <label class="text-xs text-[#2a9d8f] mr-2">الاسم الكامل</label>
                    <input type="text" id="user-name" class="input-style w-full p-4 rounded-2xl" placeholder="اكتب اسمك بالكامل">
                </div>

                <div id="creds-fields">
                    <div class="mb-5">
                        <label class="text-xs text-[#2a9d8f] mr-2">البريد الإلكتروني</label>
                        <input type="email" id="user-email" class="input-style w-full p-4 rounded-2xl" placeholder="name@nexus.com">
                    </div>
                    <div id="pass-container">
                        <label class="text-xs text-[#2a9d8f] mr-2">كلمة المرور</label>
                        <div class="pass-wrapper">
                            <input type="password" id="user-pass" class="input-style w-full p-4 rounded-2xl" placeholder="••••••••">
                            <i data-lucide="eye" id="togglePass" class="eye-icon w-5 h-5" onclick="togglePasswordVisibility()"></i>
                        </div>
                        <div id="forgot-link" class="text-left mt-2">
                            <button type="button" onclick="startRecoveryStep1()" class="text-[10px] text-gray-500 hover:text-[#2a9d8f] transition">نسيت كلمة المرور؟</button>
                        </div>
                    </div>
                </div>

                <div id="recovery-step1" class="hidden">
                    <p id="email-hint" class="text-xs text-gray-400 mb-3 text-center"></p>
                    <input type="email" id="recovery-email-check" class="input-style w-full p-4 rounded-2xl text-center" placeholder="اكتب الإيميل كاملاً">
                </div>

                <div id="recovery-step2" class="hidden">
                    <label class="text-xs text-orange-400 mr-2 block text-center">إعادة تعيين كلمة المرور الجديدة</label>
                    <input type="password" id="new-pass" class="input-style w-full p-4 rounded-2xl text-center mb-3" placeholder="كلمة المرور الجديدة">
                </div>

                <div id="otp-field" class="hidden">
                    <label class="text-xs text-[#2a9d8f] mr-2 text-center block">أدخل كود التحقق المرسل إليك</label>
                    <input type="text" id="otp-input" class="input-style w-full p-4 rounded-2xl text-center tracking-[1rem] text-xl" placeholder="0000">
                </div>

                <button type="submit" id="main-btn" class="btn-action w-full py-4 rounded-2xl font-bold text-lg mt-4 transition hover:scale-105">
                    تأكيد العملية
                </button>
            </form>

            <p id="switch-area" class="mt-8 text-sm">
                <span id="switch-text">ليس لديك حساب؟</span>
                <button onclick="toggleMode()" id="switch-btn" class="text-[#2a9d8f] font-bold underline ml-1">إنشاء حساب</button>
            </p>
        </div>
    </div>

    <div id="dashboard-container" class="hidden text-center p-8 glass-box">
        <div class="w-20 h-20 bg-[#2a9d8f]/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <i data-lucide="unlock" class="text-[#2a9d8f] w-10 h-10"></i>
        </div>
        <h1 class="text-2xl font-bold mb-4 text-white">النظام نشط بنجاح</h1>
        <p class="text-gray-400 text-sm mb-8 leading-relaxed">أهلاً بكِ في NEXUS. يمكنكِ الآن الوصول للموقع المطلوب من خلال الزر أدناه.</p>
        <button onclick="window.open('https://share.google/fIM1MVaSpPFJXB08W', '_blank')" class="btn-action w-full py-5 rounded-3xl font-bold text-xl shadow-2xl transition hover:scale-105">
            فتح الموقع المطلوب
        </button>
    </div>

    <script>
        lucide.createIcons();
        let isLogin = true;
        let isOtpStep = false;
        let isRecoveryMode = false;
        let recoveryUserEmail = null;
        let generatedOtp = null;

        window.onload = function() {
            if (localStorage.getItem('nexus_logged_in') === 'true') {
                showDashboard();
            }
        };

        function showDashboard() {
            document.getElementById('auth-container').classList.add('hidden');
            document.getElementById('dashboard-container').classList.remove('hidden');
            document.getElementById('top-bar').style.display = 'flex';
        }

        function logout() {
            localStorage.removeItem('nexus_logged_in');
            location.reload();
        }

        function showNotify(msg, type) {
            const n = document.getElementById('notify');
            n.innerText = msg;
            n.style.display = 'block';
            n.style.background = type === 'error' ? '#7f1d1d' : '#13483a';
            n.style.border = `2px solid ${type === 'error' ? '#ef4444' : '#2a9d8f'}`;
            setTimeout(() => n.style.display = 'none', 6000);
        }

        function togglePasswordVisibility() {
            const passInput = document.getElementById('user-pass');
            const eyeIcon = document.getElementById('togglePass');
            passInput.type = passInput.type === "password" ? "text" : "password";
            eyeIcon.setAttribute('data-lucide', passInput.type === "text" ? 'eye-off' : 'eye');
            lucide.createIcons();
        }

        function startRecoveryStep1() {
            const email = document.getElementById('user-email').value;
            if (!email) { return showNotify("اكتبي الإيميل أولاً لخدمة الاستعادة", "error"); }
            let users = JSON.parse(localStorage.getItem('nexus_users')) || [];
            const user = users.find(u => u.email === email);
            if (user) {
                isRecoveryMode = true;
                recoveryUserEmail = user.email;
                const hint = user.email.substring(0,2) + "********" + user.email.substring(user.email.indexOf('@'));
                document.getElementById('creds-fields').classList.add('hidden');
                document.getElementById('recovery-step1').classList.remove('hidden');
                document.getElementById('email-hint').innerText = `اختبار أمان: الإيميل يبدأ بـ (${hint})`;
                document.getElementById('title').innerHTML = 'تأكيد <span class="text-orange-400">الملكية</span>';
                document.getElementById('switch-area').classList.add('hidden');
            } else { showNotify("هذا الإيميل غير مسجل لدينا!", "error"); }
        }

        function toggleMode() {
            isLogin = !isLogin;
            document.getElementById('title').innerHTML = isLogin ? 'تسجيل <span class="text-[#2a9d8f]">الدخول</span>' : 'إنشاء <span class="text-[#2a9d8f]">حساب</span>';
            document.getElementById('name-field').classList.toggle('hidden');
            document.getElementById('switch-text').innerText = isLogin ? 'ليس لديك حساب؟' : 'لديك حساب بالفعل؟';
            document.getElementById('switch-btn').innerText = isLogin ? 'إنشاء حساب' : 'تسجيل دخول';
        }

        document.getElementById('auth-form').onsubmit = function(e) {
            e.preventDefault();
            
            // وضع الاستعادة
            if (isRecoveryMode && !document.getElementById('recovery-step1').classList.contains('hidden')) {
                const check = document.getElementById('recovery-email-check').value;
                if (check === recoveryUserEmail) {
                    document.getElementById('recovery-step1').classList.add('hidden');
                    document.getElementById('recovery-step2').classList.remove('hidden');
                    showNotify("تطابق ناجح! اكتبي كلمة المرور الجديدة", "success");
                } else { showNotify("الإيميل غير مطابق!", "error"); }
                return;
            }

            if (isRecoveryMode && !document.getElementById('recovery-step2').classList.contains('hidden')) {
                const newPass = document.getElementById('new-pass').value;
                if (newPass.length < 4) return showNotify("كلمة المرور قصيرة جداً!", "error");
                let users = JSON.parse(localStorage.getItem('nexus_users'));
                const index = users.findIndex(u => u.email === recoveryUserEmail);
                users[index].pass = newPass;
                localStorage.setItem('nexus_users', JSON.stringify(users));
                showNotify("تم التحديث! جاري التحويل...", "success");
                setTimeout(() => location.reload(), 2000);
                return;
            }

            // وضع الـ OTP
            if (isOtpStep) {
                if (document.getElementById('otp-input').value == generatedOtp) {
                    showNotify("تم التحقق بنجاح!", "success");
                    localStorage.setItem('nexus_logged_in', 'true');
                    setTimeout(showDashboard, 1000);
                } else { showNotify("كود التحقق خاطئ!", "error"); }
                return;
            }

            // وضع الدخول أو الإنشاء الأساسي
            const email = document.getElementById('user-email').value;
            const pass = document.getElementById('user-pass').value;
            let users = JSON.parse(localStorage.getItem('nexus_users')) || [];

            if (!isLogin) {
                // وضع إنشاء حساب
                const name = document.getElementById('user-name').value;
                
                // 1. فحص هل اسم المستخدم مكتوب؟
                if (!name || name.trim() === "") {
                    return showNotify("لا يمكن ترك اسم المستخدم فارغاً في إنشاء الحساب!", "error");
                }
                
                if (!email || !pass) {
                    return showNotify("يرجى إكمال جميع البيانات المطلوبة!", "error");
                }

                // 2. فحص هل الإيميل موجود مسبقاً؟
                if (users.find(u => u.email === email)) {
                    return showNotify("هذا الحساب موجود بالفعل! جربي تسجيل الدخول", "error");
                }

                // حفظ الحساب الجديد
                users.push({ name: name.trim(), email: email.trim(), pass: pass });
                localStorage.setItem('nexus_users', JSON.stringify(users));
                showNotify("تم إنشاء حسابك بنجاح! يمكنك الدخول الآن", "success");
                setTimeout(toggleMode, 1500);
            } else {
                // وضع تسجيل دخول
                const user = users.find(u => u.email === email && u.pass === pass);
                if (user) {
                    isOtpStep = true;
                    generatedOtp = Math.floor(1000 + Math.random() * 9000);
                    document.getElementById('creds-fields').classList.add('hidden');
                    document.getElementById('otp-field').classList.remove('hidden');
                    document.getElementById('switch-area').classList.add('hidden');
                    showNotify("كود التحقق: " + generatedOtp, "success");
                } else {
                    showNotify("الإيميل أو كلمة المرور غير صحيحة!", "error");
                }
            }
        };
    </script>
</body>
</html>